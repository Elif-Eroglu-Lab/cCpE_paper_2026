                # Remove ambient RNA using CellBender
def get_filtered_features(wildcards):
    return config["samples"][wildcards.sample]

# Rule 2: Create Seurat objects from CellBender-cleaned data
rule load_data:
    input:
        raw_data = get_filtered_features
    output:
        plot1 = "results/02_LoadData_filtered/{sample}/{sample}_unfiltQC.png",
        plot2 = "results/02_LoadData_filtered/{sample}/{sample}_unfilt_nFeat_vs_nCount.png",
        plot3 = "results/02_LoadData_filtered/{sample}/{sample}_unfilt_histcellspergene.png",
        table = "results/02_LoadData_filtered/{sample}/{sample}_unfiltQC.xlsx",
        rds = "results/02_LoadData_filtered/{sample}/{sample}_unfilt.rds"
    conda:
        "envs/RSeurat.yaml"
    log:
        "logs/02_LoadData_filtered/{sample}.log"
    script:
        "workflow/02_LoadData_QC.R"

# Rule 2b: Convert NCBI LOC identifiers to human-readable identifiers
rule LOCgenenames:
    input:
        rds = "results/02_LoadData_filtered/{sample}/{sample}_unfilt.rds"
    output:
        rds = "results/02b_LOCconverted/{sample}/{sample}_LOCdimred.rds"
    conda:
        "envs/RSeurat.yaml"
    script:
        "workflow/convertLOCgenenames.R"

# Rule 3: Filter cells & genes based on nFeatures, nCounts, 
rule filtering:
    input:
        rds = "results/02b_LOCconverted/{sample}/{sample}_LOCdimred.rds"
    params:
        nFeature_threshold = config["nFeature_threshold"],
        nCount_threshold = config["nCount_threshold"],
        min_cells = config["min_cells"]
    output:
        plot0 = "results/03_filtered/{sample}/{sample}_nFeat_vs_nCount_thresholds.png",
        plot1 = "results/03_filtered/{sample}/{sample}_filtQC.png",
        plot2 = "results/03_filtered/{sample}/{sample}_filt_nFeat_vs_nCount.png",
        plot3 = "results/03_filtered/{sample}/{sample}_highly_expressed_genes.png",
        table = "results/03_filtered/{sample}/{sample}_filtQC.xlsx",
        rds = "results/03_filtered/{sample}/{sample}_filt.rds"
    conda:
        "envs/RSeurat.yaml"
    log:
        "logs/03_filtered/{sample}.log"
    script:
        "workflow/03_Filtering_QC.R"

