###### 9.Build "NCBI_aPleWal1.hap1.20221129_genomic_GeneIDtoFeature_20250502_HsandMm.xlsx".
###### With "genename_Hs_PwNameFormat" and "genename_Mm_PwNameFormat" to distinguish duplicated genes.

tr2g <- read_excel("NCBI_aPleWal1.hap1.20221129_genomic_GeneIDtoFeature_20250317_HsandMm.xlsx")

### Build "genename_Hs_PwNameFormat" and "genename_Mm_PwNameFormat"
library(dplyr)
library(stringr)
tr2g <- tr2g %>%
  mutate(genename_Hs_PwNameFormat = case_when(
    
    # If gene_id_dash does not start with LOC
    !grepl("^LOC", gene_id_dash) ~ toupper(genename_Hs),
    
    # If gene_id_dash starts with LOC and genename_Hs also starts with LOC
    grepl("^LOC", gene_id_dash) & grepl("^LOC", genename_Hs) ~ genename_Hs,
    
    # If gene_id_dash starts with LOC but genename_Hs does not start with LOC
    grepl("^LOC", gene_id_dash) & !grepl("^LOC", genename_Hs) ~
      paste0(toupper(genename_Hs), "-", gene_id_dash)
  ))
View(tr2g)

tr2g <- tr2g %>%
  mutate(genename_Mm_PwNameFormat = case_when(
    
    !grepl("^LOC", gene_id_dash) ~ genename_Mm,
    
    
    grepl("^LOC", gene_id_dash) & grepl("^LOC", genename_Mm) ~ genename_Mm,
    
    
    grepl("^LOC", gene_id_dash) & !grepl("^LOC", genename_Mm) ~ 
      paste0(genename_Mm, "-", gene_id_dash)
  ))
View(tr2g)



### For the "gene_id_dash" without starting of "LOC", if it has any duplicate paralog in "genename_Hs",
### then change the content in "genename_Hs_PwNameFormat" to "gene_id_dash"-Pw

dup_names <- tr2g %>%
  count(genename_Hs) %>%
  filter(n > 1) %>%
  pull(genename_Hs)
tr2g <- tr2g %>%
  mutate(genename_Hs_PwNameFormat = if_else(
    !grepl("^LOC", gene_id_dash) & genename_Hs %in% dup_names,
    paste0(genename_Hs_PwNameFormat, "-Pw"),
    genename_Hs_PwNameFormat
  ))
View(tr2g)

dup_names <- tr2g %>%
  count(genename_Mm) %>%
  filter(n > 1) %>%
  pull(genename_Mm)
tr2g <- tr2g %>%
  mutate(genename_Mm_PwNameFormat = if_else(
    !grepl("^LOC", gene_id_dash) & genename_Mm %in% dup_names,
    paste0(genename_Mm_PwNameFormat, "-Pw"),
    genename_Mm_PwNameFormat
  ))
View(tr2g)

#Save
write_xlsx(tr2g, "NCBI_aPleWal1.hap1.20221129_genomic_GeneIDtoFeature_20250502_HsandMm.xlsx")










