        column    = "ENSEMBL",
        keytype   = "ALIAS",
        multiVals = "first"
      )
    }, error = function(e) {
      message("In ALIAS did not find: ", e$message)
      return(NA)
    })
  }
  
  
  if (is.na(mouse_ensembl)) {
    message("In SYMBOL and ALIAS did not find '", mouse_gene_symbol, "', return NA")
    return(NA)
  }
  
  
  homologs_res <- tryCatch({
    getHomologs(
      mouse_ensembl,
      species_from = "Mus musculus",
      species_to   = "Homo sapiens"
    )
  }, error = function(e) {
    message("getHomologs 出错: ", e$message)
    return(data.frame())
  })
  
  
  if (nrow(homologs_res) == 1 &&
      !is.na(homologs_res$hsapiens_homolog_ensembl_gene[1])) {
    
    human_ensembl <- homologs_res$hsapiens_homolog_ensembl_gene[1]
    
    human_symbol <- tryCatch({
      mapIds(
        org.Hs.eg.db,
        keys      = as.character(human_ensembl),
        column    = "SYMBOL",
        keytype   = "ENSEMBL",
        multiVals = "first"
      )
    }, error = function(e) {
      message("Returns an error when converting to the human gene name: ", e$message)
      return(NA)
    })
    
    return(human_symbol)
    
  } else {
    return(NA)
  }
}

