### To fill in "genename_Hs"  (ignore letter case in the input "description").
library(httr)
library(jsonlite)

fetch_gene_name_Hs <- function(protein_name) {
  query_url <- paste0("https://rest.uniprot.org/uniprotkb/search?query=",
                      URLencode(protein_name),
                      "+AND+organism_id:9606&fields=protein_name,gene_names&format=json")
  
  response <- GET(query_url)
  
  if (status_code(response) == 200) {
    content_data <- content(response, as = "text", encoding = "UTF-8")
    parsed_data <- fromJSON(content_data, flatten = TRUE)
    
    input_lower <- tolower(protein_name)  
    
    for (i in seq_along(parsed_data$results$proteinDescription.recommendedName.fullName.value)) {
      recommended_name <- parsed_data$results$proteinDescription.recommendedName.fullName.value[i]
      
      if (!is.na(recommended_name) && tolower(recommended_name) == input_lower) {
        return(parsed_data$results$genes[[i]]$geneName.value[1])
      }
      
      if (!is.null(parsed_data$results$proteinDescription.alternativeName)) {
        alternative_names <- parsed_data$results$proteinDescription.alternativeName[[i]]
        
        if (!is.null(alternative_names)) {
          alt_names_lower <- tolower(alternative_names$fullName.value)
          if (input_lower %in% alt_names_lower) {
            return(parsed_data$results$genes[[i]]$geneName.value[1])
          }
        }
      }
    }
  }
  return(NA)
}

