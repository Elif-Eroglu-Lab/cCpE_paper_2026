    result <- NA
    
    while (attempt <= max_retries && !success) {
      result <- tryCatch({
        get_mouse_gene(Full_protein_chr$genename_Hs[i])
      }, error = function(e) {
        message("Error for ", Full_protein_chr$genename_Hs[i], ": ", e$message)
