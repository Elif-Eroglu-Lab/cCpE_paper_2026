library(homologene)
library(org.Hs.eg.db)
library(org.Mm.eg.db)
library(AnnotationDbi)
library(biomaRt)

get_mouse_gene <- function(human_gene_symbol) {
  
  human_ensembl <- tryCatch({
    mapIds(
      org.Hs.eg.db,
      keys      = human_gene_symbol,
      column    = "ENSEMBL",
      keytype   = "SYMBOL",
      multiVals = "first"
    )
  }, error = function(e) {
    
    message("SYMBOL fails: ", e$message)
    return(NA)
  })
  
  
  if (is.na(human_ensembl)) {
    message("In SYMBOL did not find '", human_gene_symbol, "', try ALIAS...")
    human_ensembl <- tryCatch({
      mapIds(
        org.Hs.eg.db,
        keys      = human_gene_symbol,
        column    = "ENSEMBL",
        keytype   = "ALIAS",
        multiVals = "first"
      )
    }, error = function(e) {
      
      message("In ALIAS did not find: ", e$message)
      return(NA)
    })
  }
  
  
  if (is.na(human_ensembl)) {
    message("In SYMBOL and ALIAS did not find '", human_gene_symbol, "', return NA")
    return(NA)
  }
  
  
  homologs_res <- tryCatch({
    getHomologs(
      human_ensembl,
      species_from = "Homo sapiens",
      species_to   = "Mus musculus"
    )
  }, error = function(e) {
    
    message("getHomologs returns an error: ", e$message)
    return(data.frame())
  })
  
  
  if (nrow(homologs_res) == 1 &&
      !is.na(homologs_res$mmusculus_homolog_ensembl_gene[1])) {
    
    mouse_ensembl <- homologs_res$mmusculus_homolog_ensembl_gene[1]
    
    mouse_symbol <- tryCatch({
      mapIds(
        org.Mm.eg.db,
        keys      = as.character(mouse_ensembl),
        column    = "SYMBOL",
        keytype   = "ENSEMBL",
        multiVals = "first"
      )
    }, error = function(e) {
      message("Returns an error when converting to the mouse gene name: ", e$message)
      return(NA)
    })
    
    return(mouse_symbol)
    
  } else {
    
    return(NA)
  }
}

