rule DGE:
    input:
        rds = lambda wc: config["DGE_params"][wc.unique_code]["input_rds"]
    output:
        outfile = "../results/08_DGE/{unique_code}/{unique_code}_DGE_summary.txt",
        outplot = "../results/08_DGE/{unique_code}/{unique_code}_DGE_inputobject.png",
        outres = "../results/08_DGE/{unique_code}/{unique_code}_DGE_results.xlsx"
    resources:
        mem_mb = 10000
    params:
        unique_code = lambda wc: wc.unique_code,
        clustering = lambda wc: config["DGE_params"][wc.unique_code]["clustering"],
        reduction = lambda wc: config["DGE_params"][wc.unique_code]["reduction"],
        tst = lambda wc: config["DGE_params"][wc.unique_code]["tst"],
        ref = lambda wc: config["DGE_params"][wc.unique_code]["ref"],
        grp = lambda wc: config["DGE_params"][wc.unique_code]["grp"],
        tst_grp = lambda wc: config["DGE_params"][wc.unique_code]["tst_grp"],
        ref_grp = lambda wc: config["DGE_params"][wc.unique_code]["ref_grp"],
        grping = lambda wc: config["DGE_params"][wc.unique_code]["grping"],
        clusterwise = lambda wc: config["DGE_params"][wc.unique_code]["clusterwise"],
        ds = lambda wc: config["DGE_params"][wc.unique_code]["ds"],
        covariates = lambda wc: config["DGE_params"][wc.unique_code]["covariates"],
        test_use = lambda wc: config["DGE_params"][wc.unique_code]["test_use"],
        assay = lambda wc: config["DGE_params"][wc.unique_code]["assay"]
    conda:
        "envs/spatial.yaml"
    log:
        "logs/DGE/{unique_code}.log"
    script:
        "workflow/13_DGE.R"

# Refine DEG lists by removing genes that changed between batch 1 veh and batch 2 veh
rule DGE_refinement:
    input: 
        vehccpe = lambda wildcards: f"../results/08_DGE/{pairs[wildcards.combo_code][0]}/{pairs[wildcards.combo_code][0]}_DGE_results.xlsx",
        veh1veh2 = lambda wildcards: f"../results/08_DGE/{pairs[wildcards.combo_code][1]}/{pairs[wildcards.combo_code][1]}_DGE_results.xlsx"
    params:
        code1 = lambda wildcards: pairs[wildcards.combo_code][0],
        code2 = lambda wildcards: pairs[wildcards.combo_code][1]
    output:
        refdegs = "../results/08c_refinedDEGS/{combo_code}_refined.xlsx"
    conda:
        "envs/spatial.yaml"
    log:
        "logs/08c_refinedDEGS/{combo_code}.log"
    script:
        "workflow/08c_refineDEGs_enmasse.R"